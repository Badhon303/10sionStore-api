generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT / AUTH ────────────────────────────────────────────────────────────

model Merchant {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         Role     @default(MERCHANT)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores        Store[]
  refreshTokens RefreshToken[]
  otps          Otp[]
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Otp {
  id         String   @id @default(cuid())
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  phone      String
  code       String
  purpose    String // VERIFY | RESET
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  MERCHANT
  EMPLOYEE
}

// ─── STORE ────────────────────────────────────────────────────────────────────

model Store {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  name        String
  slug        String   @unique
  domain      String?  @unique
  logoUrl     String?
  faviconUrl  String?
  description String?
  currency    String   @default("BDT")
  isActive    Boolean  @default(true)
  plan        PlanType @default(STARTER)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees     Employee[]
  categories    Category[]
  brands        Brand[]
  products      Product[]
  orders        Order[]
  customers     Customer[]
  coupons       Coupon[]
  campaigns     Campaign[]
  landingPages  LandingPage[]
  pixels        TrackingPixel[]
  couriers      CourierConfig[]
  payments      PaymentConfig[]
  notifications Notification[]
  targets       Target[]
}

enum PlanType {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

// ─── EMPLOYEE ─────────────────────────────────────────────────────────────────

model Employee {
  id           String       @id @default(cuid())
  storeId      String
  store        Store        @relation(fields: [storeId], references: [id])
  name         String
  email        String
  phone        String?
  passwordHash String
  role         EmployeeRole @default(STAFF)
  permissions  Json?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  handledOrders Order[]

  @@unique([storeId, email])
}

enum EmployeeRole {
  MANAGER
  STAFF
  CALLER
}

// ─── CATALOG ──────────────────────────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id])
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  name      String
  slug      String
  imageUrl  String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  products  Product[]

  @@unique([storeId, slug])
}

model Brand {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id])
  name     String
  slug     String
  logoUrl  String?
  products Product[]

  @@unique([storeId, slug])
}

model Product {
  id               String        @id @default(cuid())
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id])
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?        @relation(fields: [brandId], references: [id])
  name             String
  slug             String
  sku              String?
  description      String?
  shortDescription String?
  type             ProductType   @default(PHYSICAL)
  status           ProductStatus @default(DRAFT)
  regularPrice     Decimal       @db.Decimal(12, 2)
  salePrice        Decimal?      @db.Decimal(12, 2)
  costPrice        Decimal?      @db.Decimal(12, 2)
  weight           Float?
  stockQty         Int           @default(0)
  lowStockAlert    Int           @default(5)
  trackInventory   Boolean       @default(true)
  isFeatured       Boolean       @default(false)
  metaTitle        String?
  metaDescription  String?
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  tags             ProductTag[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([storeId, slug])
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  price      Decimal     @db.Decimal(12, 2)
  stockQty   Int         @default(0)
  imageUrl   String?
  attributes Json
  orderItems OrderItem[]
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       String
}

// ─── CUSTOMER ─────────────────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  phone       String
  email       String?
  address     String?
  district    String?
  thana       String?
  isFraud     Boolean  @default(false)
  fraudScore  Float    @default(0)
  fraudNote   String?
  isBlocked   Boolean  @default(false)
  totalOrders Int      @default(0)
  totalSpent  Decimal  @default(0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders           Order[]
  incompleteOrders IncompleteOrder[]

  @@unique([storeId, phone])
}

// ─── ORDER ────────────────────────────────────────────────────────────────────

model Order {
  id               String        @id @default(cuid())
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id])
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  employeeId       String?
  employee         Employee?     @relation(fields: [employeeId], references: [id])
  orderNumber      String        @unique
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentMethod    String?
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  shippingCharge   Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  couponCode       String?
  note             String?
  shippingName     String
  shippingPhone    String
  shippingAddress  String
  shippingDistrict String
  shippingThana    String
  isFraud          Boolean       @default(false)
  isDuplicate      Boolean       @default(false)
  courierName      String?
  trackingId       String?
  courierStatus    String?
  invoicePrinted   Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String
  variantName String?
  sku         String?
  price       Decimal         @db.Decimal(12, 2)
  quantity    Int
  total       Decimal         @db.Decimal(12, 2)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())
}

// ─── INCOMPLETE ORDERS ────────────────────────────────────────────────────────

model IncompleteOrder {
  id           String    @id @default(cuid())
  storeId      String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  productId    String?
  phone        String?
  name         String?
  cartData     Json
  step         String
  isFollowedUp Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

// ─── PAYMENT ──────────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  method        String
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(UNPAID)
  transactionId String?
  gatewayRef    String?
  gatewayData   Json?
  createdAt     DateTime      @default(now())
}

model PaymentConfig {
  id       String  @id @default(cuid())
  storeId  String
  store    Store   @relation(fields: [storeId], references: [id])
  provider String
  isActive Boolean @default(false)
  config   Json

  @@unique([storeId, provider])
}

// ─── COURIER ──────────────────────────────────────────────────────────────────

model CourierConfig {
  id       String  @id @default(cuid())
  storeId  String
  store    Store   @relation(fields: [storeId], references: [id])
  provider String
  isActive Boolean @default(false)
  config   Json

  @@unique([storeId, provider])
}

// ─── COUPONS & OFFERS ─────────────────────────────────────────────────────────

model Coupon {
  id             String       @id @default(cuid())
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
  code           String
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  usageLimit     Int?
  usedCount      Int          @default(0)
  perUserLimit   Int          @default(1)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([storeId, code])
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Campaign {
  id        String       @id @default(cuid())
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id])
  name      String
  type      CampaignType
  config    Json
  isActive  Boolean      @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime     @default(now())
}

enum CampaignType {
  FLASH_SALE
  COMBO_OFFER
  POPUP_OFFER
  CONDITIONAL_DISCOUNT
}

// ─── MARKETING & TRACKING ─────────────────────────────────────────────────────

model TrackingPixel {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  type        PixelType
  pixelId     String
  accessToken String?
  isActive    Boolean   @default(true)
  config      Json?
}

enum PixelType {
  FACEBOOK_PIXEL
  FACEBOOK_CAPI
  GOOGLE_TAG_MANAGER
  GOOGLE_MERCHANT
  TIKTOK_PIXEL
}

// ─── LANDING PAGES ────────────────────────────────────────────────────────────

model LandingPage {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  title       String
  slug        String
  content     Json
  templateId  String?
  isPublished Boolean  @default(false)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, slug])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id])
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  meta      Json?
  createdAt DateTime         @default(now())
}

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  FRAUD_DETECTED
  COURIER_STATUS
  PAYMENT_RECEIVED
  SYSTEM
}

// ─── TARGETS ──────────────────────────────────────────────────────────────────

model Target {
  id          String       @id @default(cuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id])
  period      TargetPeriod
  month       Int?
  year        Int
  salesTarget Decimal      @db.Decimal(14, 2)
  orderTarget Int
  createdAt   DateTime     @default(now())
}

enum TargetPeriod {
  DAILY
  MONTHLY
  YEARLY
}
